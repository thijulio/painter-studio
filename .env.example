# ── Auth: Netlify Identity + Google (client-safe) ─────
# Set these when the Expo auth feature is implemented. Google uses Netlify's
# default provider on the current plan; no Google client secret belongs here.
EXPO_PUBLIC_NETLIFY_SITE_ID=
EXPO_PUBLIC_NETLIFY_IDENTITY_URL=

# ── AWS S3 (imagens) ──────────────────────────────────
S3_BUCKET=
S3_REGION=eu-west-3
# Netlify reserves the AWS_* names. Functions map these server-side values to
# the AWS SDK credential provider; never expose them to Expo.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Neon Postgres (server-side only; never expose to Expo) ──
DATABASE_URL=
